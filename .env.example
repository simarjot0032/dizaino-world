# Copy this file to .env and fill in the values.
# Vite only exposes variables prefixed with VITE_ to the site.
# These values end up in the public JavaScript bundle; that is expected for
# Firebase web config and the Cloudinary cloud name / API key.
# Only the server-only section below stays private.

# --- Firebase (Project settings -> General -> Your apps -> Web app config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Optional: leave empty to use https://<project-id>-default-rtdb.firebaseio.com.
# Set it if you created the Realtime Database in a non-US region (copy the URL from the Realtime Database page).
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
# Optional (only needed for Analytics):
VITE_FIREBASE_APP_ID=

# --- Cloudinary (Dashboard -> "API Keys": Cloud name, API Key, API Secret) ---
# Uploads are SIGNED by the /api functions; no upload preset is used.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_API_KEY=

# --- Server-only (used by /api functions on Vercel; no VITE_ prefix, so Vite
#     never puts these in the website bundle) ---
CLOUDINARY_API_SECRET=
# Comma-separated admin emails allowed to upload/delete images.
ADMIN_EMAILS=
